{
  "name": "InstantNode",
  "short_name": "InstantNode",
  "description": "Manage your servers, game servers, bots and billing on the go.",
  "id": "/dashboard",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0b1220",
  "theme_color": "#0b1220",
  "icons": [
    { "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Servers", "url": "/dashboard/containers", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }] },
    { "name": "Billing", "url": "/dashboard/billing", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }] },
    { "name": "Tickets", "url": "/dashboard/tickets", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }] }
  ]
}
